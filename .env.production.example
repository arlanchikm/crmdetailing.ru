APP_DOMAIN=example.ru
TLS_ASK_TOKEN=generate-a-long-random-token

DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_PRIMARY_DOMAIN=example.ru
DJANGO_PLATFORM_OWNER_EMAIL=owner@example.invalid
DJANGO_ALLOWED_HOSTS=web,localhost,127.0.0.1,example.ru,www.example.ru,.example.ru
DJANGO_PUBLIC_HOSTS=web,localhost,127.0.0.1,example.ru,www.example.ru
DJANGO_TENANT_DOMAIN_SUFFIXES=.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.ru,https://www.example.ru,https://*.example.ru
DJANGO_EMAIL_HOST=smtp.yandex.ru
DJANGO_EMAIL_PORT=465
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=0
DJANGO_EMAIL_TIMEOUT=30
DJANGO_DEFAULT_FROM_EMAIL=CRM Detailing <no-reply.crmdetailing@yandex.ru>
DJANGO_SUPPORT_EMAIL=info.crmdetailing@yandex.ru
DJANGO_SECURE_HSTS_SECONDS=0

POSTGRES_DB=crm_detailing
POSTGRES_USER=crm_detailing
POSTGRES_PASSWORD=generate-a-long-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
GUNICORN_WORKERS=3

# Yandex SMTP uses SSL on port 465, TLS must be disabled with SSL.
DJANGO_EMAIL_USE_SSL=1
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=1
