#!/bin/sh
set -eu
umask 077

PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
BACKUP_DIR=${1:-"$PROJECT_DIR/backups"}
STAMP=$(date +%Y%m%d-%H%M%S)
mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"
cd "$PROJECT_DIR"
ENV_FILE=${PRODUCTION_ENV_FILE:-"$PROJECT_DIR/.env.production"}

if [ ! -f "$ENV_FILE" ]; then
  echo "$ENV_FILE не найден." >&2
  exit 1
fi

set -a
. "$ENV_FILE"
set +a

docker compose --env-file "$ENV_FILE" -f compose.prod.yaml exec -T db \
  pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc > "$BACKUP_DIR/database-$STAMP.dump"
docker compose --env-file "$ENV_FILE" -f compose.prod.yaml run --rm --no-deps -T web \
  tar -czf - -C /app media > "$BACKUP_DIR/media-$STAMP.tar.gz"

echo "Созданы резервные копии в $BACKUP_DIR"
