# Поместите заполненный файл в /etc/crm-detailing/backup.env с правами 600.
# Используйте отдельный статический ключ сервисного аккаунта с ролью
# storage.editor только на закрытый бакет резервных копий.
RESTIC_REPOSITORY='s3:https://storage.yandexcloud.net/crmdetailing-backup/crm-detailing/production'
RESTIC_PASSWORD_FILE='/etc/crm-detailing/restic-password'
AWS_ACCESS_KEY_ID='replace-with-access-key-id'
AWS_SECRET_ACCESS_KEY='replace-with-secret-access-key'
# Старые снимки удаляются после успешной отправки новой копии.
RESTIC_RETENTION='true'
