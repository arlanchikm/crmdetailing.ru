{
	on_demand_tls {
		ask http://web:8000/internal/tls/allow/?token={$TLS_ASK_TOKEN}
	}
}

(crm_app) {
	encode zstd gzip

	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	reverse_proxy web:8000

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}
}

www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

{$APP_DOMAIN} {
	import crm_app
}

https:// {
	tls {
		on_demand
	}
	import crm_app
}
